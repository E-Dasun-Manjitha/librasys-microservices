	"item": [
		{
			"name": "Student 1 - Auth & Member Service (Port 8081)",
			"item": [
				{
					"name": "1.1 Direct Register Member (Port 8081)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.id) {",
									"    pm.collectionVariables.set('memberId', jsonData.id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "X-API-KEY",
								"value": "auth-service-key-2026"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Student Demo User\",\n  \"email\": \"student_demo@librasys.test\",\n  \"password\": \"Password123!\"\n}"
						},
						"url": {
							"raw": "http://localhost:8081/api/auth/register",
							"protocol": "http",
							"host": ["localhost"],
							"port": "8081",
							"path": ["api", "auth", "register"]
						}
					}
				},
				{
					"name": "1.2 Direct Login Member & Auto-Save JWT (Port 8081)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.token) {",
									"    pm.collectionVariables.set('jwt_token', jsonData.token);",
									"    pm.collectionVariables.set('memberId', jsonData.id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "X-API-KEY",
								"value": "auth-service-key-2026"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"student_demo@librasys.test\",\n  \"password\": \"Password123!\"\n}"
						},
						"url": {
							"raw": "http://localhost:8081/api/auth/login",
							"protocol": "http",
							"host": ["localhost"],
							"port": "8081",
							"path": ["api", "auth", "login"]
						}
					}
				},
				{
					"name": "1.3 Direct Get Member by ID (Port 8081)",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "X-API-KEY",
								"value": "auth-service-key-2026"
							}
						],
						"url": {
							"raw": "http://localhost:8081/api/members/{{memberId}}",
							"protocol": "http",
							"host": ["localhost"],
							"port": "8081",
							"path": ["api", "members", "{{memberId}}"]
						}
					}
				},
				{
					"name": "1.4 Test Security Block (Missing API Key -> 401)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "http://localhost:8081/api/members/{{memberId}}",
							"protocol": "http",
							"host": ["localhost"],
							"port": "8081",
							"path": ["api", "members", "{{memberId}}"]
						}
					}
				}
			]
		},
