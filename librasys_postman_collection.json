{
	"info": {
		"_postman_id": "librasys-complete-collection-2026",
		"name": "LibraSys Microservices - Member-by-Member Verification",
		"description": "Complete Postman Collection for testing all individual microservices directly (Ports 8081-8085) with X-API-KEY headers and via API Gateway (Port 8080) with OAuth 2.0 / JWT tokens.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "gatewayUrl",
			"value": "http://localhost:8080",
			"type": "string"
		},
		{
			"key": "jwt_token",
			"value": "",
			"type": "string"
		},
		{
			"key": "memberId",
			"value": "",
			"type": "string"
		},
		{
			"key": "bookId",
			"value": "",
			"type": "string"
		},
		{
			"key": "loanId",
			"value": "",
			"type": "string"
		},
		{
			"key": "reservationId",
			"value": "",
			"type": "string"
		}
