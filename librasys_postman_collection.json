		{
			"name": "API Gateway (Port 8080 - Central End-to-End)",
			"item": [
				{
					"name": "Gateway Register (/api/auth/register)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Gateway Tester\",\n  \"email\": \"gateway_user@librasys.test\",\n  \"password\": \"Password123!\"\n}"
						},
						"url": {
							"raw": "{{gatewayUrl}}/api/auth/register",
							"host": ["{{gatewayUrl}}"],
							"path": ["api", "auth", "register"]
						}
					}
				},
				{
					"name": "Gateway Login & Token Issuance (/api/auth/login)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.token) {",
									"    pm.collectionVariables.set('jwt_token', jsonData.token);",
									"    pm.collectionVariables.set('memberId', jsonData.id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"gateway_user@librasys.test\",\n  \"password\": \"Password123!\"\n}"
						},
						"url": {
							"raw": "{{gatewayUrl}}/api/auth/login",
							"host": ["{{gatewayUrl}}"],
							"path": ["api", "auth", "login"]
						}
					}
				},
				{
					"name": "Gateway Fetch Books (/api/books with JWT)",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{jwt_token}}"
							}
						],
						"url": {
							"raw": "{{gatewayUrl}}/api/books",
							"host": ["{{gatewayUrl}}"],
							"path": ["api", "books"]
						}
					}
				},
				{
					"name": "Gateway Borrow Book (/api/loans with JWT)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{jwt_token}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"memberId\": \"{{memberId}}\",\n  \"bookId\": \"{{bookId}}\"\n}"
						},
						"url": {
							"raw": "{{gatewayUrl}}/api/loans",
							"host": ["{{gatewayUrl}}"],
							"path": ["api", "loans"]
						}
					}
				},
