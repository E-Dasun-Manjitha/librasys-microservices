# ==========================================
# LibraSys Microservices Environment Variables
# ==========================================

# --- Service Discovery ---
EUREKA_SERVER_URL=http://eureka-server:8761/eureka/

# --- Inter-Service URLs ---
SERVICES_AUTH_SERVICE_URL=http://auth-service:8081
SERVICES_BOOK_SERVICE_URL=http://book-service:8082
SERVICES_LOAN_SERVICE_URL=http://loan-service:8083
SERVICES_RESERVATION_SERVICE_URL=http://reservation-service:8084
SERVICES_NOTIFICATION_SERVICE_URL=http://notification-service:8085

# --- Security / API Keys ---
# Used for securing internal microservice-to-microservice communication
SERVICES_BOOK_SERVICE_API_KEY=book-service-key-2026
SERVICES_NOTIFICATION_SERVICE_API_KEY=notification-horizon/services-2026

# JWT Secret Key (from API Gateway)
JWT_SECRET=LibraSys2026SuperSecretKeyForJWTSigningMustBeAtLeast256Bits!!

# --- Database Configurations ---
# Redis (API Gateway Rate Limiting)
SPRING_DATA_REDIS_HOST=redis

# MongoDB URIs
# (Note: In docker-compose, these are assigned directly per service.
# If running locally without docker, change 'mongo-X' to 'localhost' and ports to 27019-27023)
AUTH_MONGODB_URI=mongodb://mongo-auth:27017/librasys_auth
BOOKS_MONGODB_URI=mongodb://mongo-books:27017/librasys_books
LOANS_MONGODB_URI=mongodb://mongo-loans:27017/librasys_loans
RESERVATIONS_MONGODB_URI=mongodb://mongo-reservations:27017/librasys_reservations
NOTIFICATIONS_MONGODB_URI=mongodb://mongo-notifications:27017/librasys_notifications
